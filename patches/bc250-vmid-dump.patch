+static int bc250_flush_mapped_vmids;
+module_param(bc250_flush_mapped_vmids, int, 0644);
+MODULE_PARM_DESC(bc250_flush_mapped_vmids,
+	"BC-250: 0=off (stock KIQ path) 1=bypass KIQ + invalidate all mapped VMIDs");
