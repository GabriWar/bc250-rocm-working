+/* BC-250: quem o hardware acha que e quem.
+ *
+ * A invalidacao de compute (gmc_v10_0_flush_gpu_tlb_pasid) NAO invalida "o
+ * processo": ela varre os 16 VMIDs perguntando ao ATC qual deles carrega o
+ * nosso PASID, e so invalida esse. Se a consulta responder errado -- e a
+ * anotacao acima diz que ela pode -- o flush cai no VMID de outro processo,
+ * ou em nenhum, e volta. E o contador kfd_last_flushed_seq e atualizado ANTES
+ * disso (amdgpu_vm.c:1757), entao ele diz "invalidado" de qualquer forma.
+ *
+ * Este despejo separa as duas visoes:
+ *   ATC pasid      o que o HARDWARE acha que cada VMID contem
+ *   pd_gpu_addr    qual page directory o DRIVER carregou em cada VMID
+ * Se nenhum VMID casar com o nosso PASID, a invalidacao nao atinge nada.
+ */
+void amdgpu_bc250_dump_vmids(struct amdgpu_device *adev, uint64_t nosso_pd,
+			     uint16_t nosso_pasid, struct seq_file *m)
+{
+	struct amdgpu_vmid_mgr *mgr = &adev->vm_manager.id_mgr[AMDGPU_GFXHUB(0)];
+	int vmid, casam_pasid = 0, casam_pd = 0;
+
+	seq_printf(m, "  --- mapa de VMIDs (nosso pasid=0x%x, nosso pd=0x%llx) ---\n",
+		   nosso_pasid, nosso_pd);
+	for (vmid = 0; vmid < AMDGPU_NUM_VMID; vmid++) {
+		uint16_t pasid = 0;
+		bool valid = gmc_v10_0_get_atc_vmid_pasid_mapping_info(adev, vmid,
+								      &pasid);
+		uint64_t pd = mgr->ids[vmid].pd_gpu_addr;
+		const char *marca = "";
+
+		if (valid && pasid == nosso_pasid) {
+			casam_pasid++;
+			marca = "   <<< o ATC diz que este VMID e o NOSSO";
+		} else if (pd && pd == nosso_pd) {
+			casam_pd++;
+			marca = "   <<< o DRIVER carregou nosso page directory aqui";
+		}
+		seq_printf(m, "    vmid %2d  ATC=%-6s pasid=0x%-4x  pd=0x%llx%s\n",
+			   vmid, valid ? "valido" : "INVAL", pasid,
+			   (unsigned long long)pd, marca);
+	}
+	seq_printf(m, "    >>> VMIDs cujo ATC casa com o nosso PASID: %d\n", casam_pasid);
+	if (!casam_pasid) {
+		seq_puts(m, "    >>> NENHUM. A invalidacao por PASID varre os 16, nao casa\n"
+			    "    >>> com nada e volta SEM INVALIDAR -- e mesmo assim o\n"
+			    "    >>> contador ja foi marcado como invalidado.\n");
+		if (casam_pd)
+			seq_printf(m, "    >>> mas o driver TEM nosso page directory em %d VMID(s):\n"
+				      "    >>> a traducao esta viva num VMID que o flush nao alcanca.\n",
+				   casam_pd);
+	}
+}
