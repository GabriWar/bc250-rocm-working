+static int bc250_dead_gpu_guard;
+module_param(bc250_dead_gpu_guard, int, 0644);
+MODULE_PARM_DESC(bc250_dead_gpu_guard,
+	"BC-250: 0=off 1=abort TLB flush when MMIO reads return 0xFFFFFFFF");
