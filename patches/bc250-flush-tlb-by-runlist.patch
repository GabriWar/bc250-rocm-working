+/* BC-250/gfx1013: invalidate the compute TLB by rebuilding the runlist.
+ *
+ * The problem
+ * -----------
+ * On this board compute TLB invalidation NEVER happens. The PASID scan in
+ * gmc_v10_0_flush_gpu_tlb_pasid() depends on mmATC_VMID*_PASID_MAPPING, which
+ * on gfx10 under HWS is never written -- measured: 20 of 20 flushes hitting
+ * zero VMIDs, and the same "0 VMID(s) flushed" reproduced on another machine.
+ * Forcing it over MMIO does not help either: neither the KIQ route nor the
+ * direct-register one is acknowledged, and the attempt wedges the translation
+ * unit and resets the GPU.
+ *
+ * Consequence: hipFree tears the mapping down, hipMalloc reuses the same VA
+ * range with a different physical address, the new PTEs are correct in memory,
+ * and the GPU keeps translating through the previous mapping.
+ *
+ * What is left, and why this path
+ * -------------------------------
+ * A process CANNOT clear its own stale translation: 32 accesses to fresh pages
+ * plus a compute dispatch leave the page wrong 20/20, before and after. ONE
+ * access by ANOTHER process clears it immediately, 0/20. Mapping the same BO
+ * into a second VM without accessing it does NOT clear it.
+ *
+ * So an invalidation that works does exist on this silicon, and what triggers
+ * it is the hardware scheduler activating another process -- it preempts the
+ * queues, rebuilds the runlist and reassigns VMIDs. It has to invalidate,
+ * otherwise a process would inherit the previous one's translations along with
+ * its VMID. This function asks for that same cycle on purpose, on unmap, so the
+ * stale translation is never generated in the first place.
+ *
+ * Where it can and cannot be called
+ * ---------------------------------
+ * It takes dqm_lock. kfd_flush_tlb() must NOT call it: in
+ * restore_process_queues_nocpsch() the lock is already held, and in
+ * allocate_vmid()/deallocate_vmid() too -- that would deadlock, and a deadlock
+ * here hangs the machine, not just the GPU. The only call site is the unmap
+ * ioctl in kfd_chardev.c, which holds p->mutex and not dqm_lock (the ordering
+ * p->mutex -> dqm_lock is the same one pqm_create_queue already uses).
+ *
+ * Off by default:  amdgpu.bc250_flush_by_runlist=1
+ */
+#define BC250_PCI_DEVICE_ID 0x13FE
+
+static int bc250_flush_by_runlist;
+module_param(bc250_flush_by_runlist, int, 0644);
+MODULE_PARM_DESC(bc250_flush_by_runlist,
+	"BC-250: 1=on unmap, invalidate the TLB by rebuilding the runlist (0 = default)");
+
+int kfd_bc250_flush_by_runlist(struct kfd_node *dev)
+{
+	struct device_queue_manager *dqm;
+	int r;
+
+	if (!bc250_flush_by_runlist || !dev || !dev->adev || !dev->adev->pdev)
+		return 0;
+	if (dev->adev->pdev->device != BC250_PCI_DEVICE_ID)
+		return 0;
+
+	dqm = dev->dqm;
+	/* Only makes sense under hardware scheduling: it is the firmware that
+	 * reassigns VMIDs when rebuilding the runlist. Without HWS there is no
+	 * runlist.
+	 */
+	if (!dqm || dqm->sched_policy == KFD_SCHED_POLICY_NO_HWS)
+		return 0;
+
+	dqm_lock(dqm);
+	r = execute_queues_cpsch(dqm, KFD_UNMAP_QUEUES_FILTER_DYNAMIC_QUEUES, 0,
+				 USE_DEFAULT_GRACE_PERIOD);
+	dqm_unlock(dqm);
+
+	if (r)
+		dev_err_ratelimited(dev->adev->dev,
+			"BC-250: rebuilding the runlist failed (%d)\n", r);
+	return r;
+}
