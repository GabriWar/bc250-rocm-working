 DEFINE_DEBUGFS_ATTRIBUTE(fops_sclk_set, NULL,
 			amdgpu_debugfs_sclk_set, "%llu\n");
 
+
+/* ==================================================================
+ * BC-250: /sys/kernel/debug/dri/N/bc250_ptwalk
+ *
+ *   echo "<pasid_hex> <va_hex>" > bc250_ptwalk
+ *   cat bc250_ptwalk
+ *
+ * Walks the page table hierarchy from inside the driver, where the
+ * pointers are real. It exists because checking this from outside is imprecise:
+ * with vm_update_mode=3 the tracepoint's `pe` field is a KERNEL address, not
+ * physical, and scanning VRAM for the value does not say which VA each slot belongs to.
+ *
+ * Memory reads only. It touches no register: raw MMIO on this board has
+ * already hung the machine.
+ */
+static u32 bc250_ptwalk_pasid;
+static u64 bc250_ptwalk_va;
+
+static int bc250_ptwalk_show(struct seq_file *m, void *unused)
+{
+	struct amdgpu_device *adev = (struct amdgpu_device *)m->private;
+
+	if (!bc250_ptwalk_pasid) {
+		seq_puts(m, "uso: echo \"<pasid_hex> <va_hex>\" > bc250_ptwalk\n");
+		return 0;
+	}
+	amdgpu_bc250_ptwalk(adev, bc250_ptwalk_pasid, bc250_ptwalk_va, m);
+	return 0;
+}
+
+static int bc250_ptwalk_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, bc250_ptwalk_show, inode->i_private);
+}
+
+static ssize_t bc250_ptwalk_write(struct file *file, const char __user *buf,
+				  size_t len, loff_t *off)
+{
+	char linha[64];
+	u32 pasid;
+	u64 va;
+
+	if (len >= sizeof(linha))
+		return -EINVAL;
+	if (copy_from_user(linha, buf, len))
+		return -EFAULT;
+	linha[len] = 0;
+	if (sscanf(linha, "%x %llx", &pasid, &va) != 2)
+		return -EINVAL;
+	bc250_ptwalk_pasid = pasid;
+	bc250_ptwalk_va = va;
+	return len;
+}
+
+static const struct file_operations bc250_ptwalk_fops = {
+	.owner   = THIS_MODULE,
+	.open    = bc250_ptwalk_open,
+	.read    = seq_read,
+	.write   = bc250_ptwalk_write,
+	.llseek  = seq_lseek,
+	.release = single_release,
+};
+
