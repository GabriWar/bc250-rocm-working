+/* BC-250: acha a amdgpu_vm de um processo pelo PID.
+ *
+ * Nao da para usar PASID nesta placa: o BIOS desliga SVM
+ * ("SVM disabled (by BIOS) in MSR_VM_CR") e o KFD reporta pasid=0 em
+ * /sys/class/kfd/kfd/proc/<pid>/pasid, entao a xarray adev->vm_manager.pasids
+ * nunca acha a VM de um processo de compute. O PID resolve pelo caminho do
+ * proprio KFD, que e quem de fato tem o ponteiro.
+ */
+struct amdgpu_vm *amdgpu_bc250_vm_from_pid(u32 nr)
+{
+	struct kfd_process *p;
+	struct amdgpu_vm *vm = NULL;
+	struct pid *pid;
+
+	pid = find_get_pid(nr);
+	if (!pid)
+		return NULL;
+	p = kfd_lookup_process_by_pid(pid);
+	put_pid(pid);
+	if (!p)
+		return NULL;
+	if (p->n_pdds > 0 && p->pdds[0] && p->pdds[0]->drm_priv)
+		vm = drm_priv_to_vm(p->pdds[0]->drm_priv);
+	kfd_unref_process(p);
+	return vm;
+}
