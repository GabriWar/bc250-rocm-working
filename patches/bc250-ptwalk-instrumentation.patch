--- amdgpu_vm_pt.c.pre-ptwalk.bak	2026-08-07 00:01:03.185273260 -0300
+++ amdgpu_vm_pt.c	2026-08-07 01:26:05.078939161 -0300
@@ -21,11 +21,13 @@
