+
+/* BC-250: finds a process's amdgpu_vm by PID.
+ *
+ * PASID cannot be used on this board: the BIOS disables SVM
+ * ("SVM disabled (by BIOS) in MSR_VM_CR") and KFD reports pasid=0 in
+ * /sys/class/kfd/kfd/proc/<pid>/pasid, so the adev->vm_manager.pasids xarray
+ * never finds a compute process's VM. The PID resolves through KFD's own
+ * path, which is what actually holds the pointer.
+ */
+struct amdgpu_vm *amdgpu_bc250_vm_from_pid(u32 nr)
+{
+	struct kfd_process *p;
+	struct amdgpu_vm *vm = NULL;
+	struct pid *pid;
+
+	pid = find_get_pid(nr);
+	if (!pid)
+		return NULL;
+	p = kfd_lookup_process_by_pid(pid);
+	put_pid(pid);
+	if (!p)
+		return NULL;
+	if (p->n_pdds > 0 && p->pdds[0] && p->pdds[0]->drm_priv)
+		vm = drm_priv_to_vm(p->pdds[0]->drm_priv);
+	kfd_unref_process(p);
+	return vm;
+}
