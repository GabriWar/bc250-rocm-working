+
+/* ==================================================================
+ * BC-250: walks the page table hierarchy for a VA.
+ *
+ * Why this exists
+ * ---------------
+ * Doc 17 concludes that the page tables are CORRECT and therefore that the
+ * GPU reads outside them. That conclusion underpins everything that came after
+ * -- and it was drawn by checking the PTE at offset 0 of each block, while the
+ * corruption starts at the tail (85 of 87 offsets are exact multiples of 2 MiB,
+ * and in one measured case the block fails from offset 4 MiB to the end).
+ *
+ * Verifying that from outside is imprecise: with vm_update_mode=3 the `pe` field
+ * of the tracepoint is a KERNEL virtual address (amdgpu_vm_cpu.c:87), not
+ * physical, and scanning 12 GiB of VRAM for the value does not say which VA each
+ * slot belongs to. In here the pointers are real and the cursor is the driver's own.
+ *
+ * Usage
+ * -----
+ *   echo "<pasid_hex> <va_hex>" > /sys/kernel/debug/dri/1/bc250_ptwalk
+ *   cat /sys/kernel/debug/dri/1/bc250_ptwalk
+ *
+ * Prints, per level: index, raw entry, decoded flags, physical
+ * address, the table BO, and the neighbouring entries. At the end it compares
+ * what the walk found against what the driver's interval tree says should be
+ * mapped -- the two sources that need to agree.
+ *
+ * Read only. It touches no register: a raw MMIO read on this board has
+ * hung the machine before.
+ */
+
+static const char *bc250_nivel(unsigned int l)
+{
+	switch (l) {
+	case AMDGPU_VM_PDB2: return "PDB2";
+	case AMDGPU_VM_PDB1: return "PDB1";
+	case AMDGPU_VM_PDB0: return "PDB0";
+	case AMDGPU_VM_PTB:  return "PTB ";
+	default:             return "????";
+	}
+}
+
+static void bc250_decodifica(struct seq_file *m, uint64_t e)
+{
+	seq_printf(m, "        flags: %s%s%s%s%s%s%s%s frag=%llu mtype=%llu\n",
+		   (e & AMDGPU_PTE_VALID)      ? "VALID "   : "",
+		   (e & AMDGPU_PTE_SYSTEM)     ? "SYSTEM "  : "",
+		   (e & AMDGPU_PTE_SNOOPED)    ? "SNOOP "   : "",
+		   (e & AMDGPU_PTE_EXECUTABLE) ? "EXEC "    : "",
+		   (e & AMDGPU_PTE_READABLE)   ? "READ "    : "",
+		   (e & AMDGPU_PTE_WRITEABLE)  ? "WRITE "   : "",
+		   (e & AMDGPU_PTE_PRT)        ? "PRT "     : "",
+		   (e & AMDGPU_PDE_PTE)        ? "PDE_PTE(pagina grande) " : "",
+		   (e >> 7) & 0x1f,
+		   (e >> 48) & 0x3);
+}
+
+static uint64_t bc250_le_entrada(struct amdgpu_bo *tab, unsigned int idx,
+				 struct seq_file *m)
+{
+	uint64_t *p;
+
+	if (!tab) {
+		seq_puts(m, "        !! BO da tabela e NULL\n");
+		return 0;
+	}
+	p = amdgpu_bo_kptr(tab);
+	if (!p) {
+		seq_puts(m, "        !! tabela nao esta kmapeada (vm_update_mode=0?)\n");
+		return 0;
+	}
+	return p[idx];
+}
+
+void amdgpu_bc250_ptwalk(struct amdgpu_device *adev, u32 pasid, uint64_t va,
+			 struct seq_file *m)
+{
+	struct amdgpu_bo_va_mapping *mapa;
+	struct amdgpu_vm_pt_cursor cur;
+	struct amdgpu_vm *vm;
+	uint64_t pfn = va >> AMDGPU_GPU_PAGE_SHIFT;
+	unsigned long flags;
+	int passo = 0;
+	int grande = 0;
+
+	/* the argument is treated as a PID first: on this board SVM is
+	 * disabled by the BIOS and KFD reports pasid=0, so the pasid xarray
+	 * never finds a compute process's VM. If that fails, try it as a pasid.
+	 */
+	vm = amdgpu_bc250_vm_from_pid(pasid);
+	if (vm) {
+		seq_printf(m, "  (resolvido por PID %u)\n", pasid);
+	} else {
+		xa_lock_irqsave(&adev->vm_manager.pasids, flags);
+		vm = xa_load(&adev->vm_manager.pasids, pasid);
+		xa_unlock_irqrestore(&adev->vm_manager.pasids, flags);
+		if (vm)
+			seq_printf(m, "  (resolvido por PASID 0x%x)\n", pasid);
+	}
+	if (!vm) {
+		seq_printf(m, "nem PID %u nem PASID 0x%x tem VM registrada\n",
+			   pasid, pasid);
+		return;
+	}
+
+	/* Safety latch: the walk follows pointers into structures the VM may be
+	 * mutating (the table hierarchy and the mapping tree). Reading that
+	 * concurrently with a change would follow a dead pointer and take the
+	 * kernel down.
+	 *
+	 * So: trylock. If the VM is busy, abort and say so. Never wait, so that
+	 * neither the reader nor the target process can be blocked -- this is a
+	 * debug path, and debugging that hangs the machine is useless.
+	 */
+	if (!vm->root.bo) {
+		seq_puts(m, "VM sem BO raiz\n");
+		return;
+	}
+	if (!dma_resv_trylock(vm->root.bo->tbo.base.resv)) {
+		seq_puts(m, "VM OCUPADA: nao consegui o lock sem esperar.\n"
+			    "Abortado de proposito -- seguir ponteiro instavel\n"
+			    "derrubaria o kernel. Deixe o processo alvo parado\n"
+			    "(sem alocar/liberar) e tente de novo.\n");
+		return;
+	}
+
+	seq_printf(m, "=== BC-250 ptwalk  pasid=0x%x  va=0x%llx  pfn=0x%llx ===\n",
+		   pasid, va, pfn);
+	seq_printf(m, "  vm=%p  compute=%d  pasid=0x%x\n",
+		   vm, vm->is_compute_context, vm->pasid);
+	/* --- did the invalidation ever happen for this VM's changes? ---
+	 *
+	 * tlb_seq counts table updates; kfd_last_flushed_seq counts what has
+	 * already been invalidated. amdgpu_vm_flush_compute_tlb() DROPS the flush
+	 * when the two are equal -- and we measured on this board that this
+	 * happens half the time (20 SKIPPED to 20 FLUSH).
+	 *
+	 * If here, at the moment of failure, tlb_seq > kfd_last_flushed_seq, then
+	 * there are mapping changes the GPU was never told about, and the
+	 * translation it used may predate them.
+	 */
+	{
+		u64 s = atomic64_read(&vm->tlb_seq);
+		u64 f = atomic64_read(&vm->kfd_last_flushed_seq);
+
+		seq_printf(m, "  tlb_seq=%llu  kfd_last_flushed_seq=%llu\n",
+			   (unsigned long long)s, (unsigned long long)f);
+		if (s > f)
+			seq_printf(m, "  >>> INVALIDACAO PENDENTE: %llu atualizacoes de tabela\n"
+				      "  >>> ainda nao invalidadas. A GPU pode estar usando\n"
+				      "  >>> traducao anterior a elas.\n",
+				   (unsigned long long)(s - f));
+		else if (s == f)
+			seq_puts(m, "  >>> invalidacao EM DIA: nada pendente neste instante\n");
+		else
+			seq_puts(m, "  >>> ESTADO IMPOSSIVEL: flushed > seq (contador correu?)\n");
+	}
+	seq_printf(m, "  geometria: %u niveis, root_level=%u, block_size=%u, frag=%u\n",
+		   adev->vm_manager.num_level, adev->vm_manager.root_level,
+		   adev->vm_manager.block_size, adev->vm_manager.fragment_size);
+	if (vm->root.bo)
+		seq_printf(m, "  raiz: bo=%p  gpu_addr=0x%llx  tam=%llu  kptr=%p\n",
+			   vm->root.bo, amdgpu_bo_gpu_offset_no_check(vm->root.bo),
+			   (unsigned long long)amdgpu_bo_size(vm->root.bo),
+			   amdgpu_bo_kptr(vm->root.bo));
+
+	amdgpu_bc250_dump_vmids(adev,
+				vm->root.bo ? amdgpu_bo_gpu_offset_no_check(vm->root.bo) : 0,
+				vm->pasid, m);
+
+	/* --- what the driver THINKS it mapped here --- */
+	seq_puts(m, "  --- arvore de intervalos (a intencao do driver) ---\n");
+	mapa = amdgpu_vm_bo_lookup_mapping(vm, pfn);
+	if (!mapa) {
+		seq_printf(m, "    NENHUM mapeamento cobre pfn 0x%llx\n", pfn);
+	} else {
+		struct amdgpu_bo *bo = mapa->bo_va ? mapa->bo_va->base.bo : NULL;
+
+		seq_printf(m, "    mapeamento: start=0x%llx last=0x%llx offset=0x%llx flags=0x%llx\n",
+			   mapa->start, mapa->last, mapa->offset,
+			   (unsigned long long)mapa->flags);
+		if (bo)
+			seq_printf(m, "    BO por tras: %p  gpu_addr=0x%llx  tam=%llu  dominio=%u\n",
+				   bo, amdgpu_bo_gpu_offset_no_check(bo),
+				   (unsigned long long)amdgpu_bo_size(bo),
+				   bo->preferred_domains);
+		else
+			seq_puts(m, "    BO por tras: NENHUM (mapeamento PRT/limpo?)\n");
+	}
+
+	/* --- a caminhada de verdade, nivel a nivel --- */
+	seq_puts(m, "  --- caminhada na hierarquia (o que o hardware leria) ---\n");
+	amdgpu_vm_pt_start(adev, vm, pfn, &cur);
+	do {
+		struct amdgpu_bo *tab = cur.parent ? cur.parent->bo : NULL;
+		unsigned int mask, shift, idx;
+		uint64_t e;
+		int j;
+
+		if (!cur.parent) {          /* logo apos o start: ainda na raiz */
+			seq_printf(m, "    [%s] raiz, nada a decodificar ainda\n",
+				   bc250_nivel(cur.level));
+			continue;
+		}
+		mask  = amdgpu_vm_pt_entries_mask(adev, cur.level - 1);
+		shift = amdgpu_vm_pt_level_shift(adev, cur.level - 1);
+		idx   = (pfn >> shift) & mask;
+		e     = bc250_le_entrada(tab, idx, m);
+
+		seq_printf(m, "    [%s] passo %d  shift=%u mask=0x%x idx=%u\n",
+			   bc250_nivel(cur.level), passo, shift, mask, idx);
+		seq_printf(m, "        tabela: bo=%p gpu_addr=0x%llx kptr=%p\n",
+			   tab, amdgpu_bo_gpu_offset_no_check(tab),
+			   amdgpu_bo_kptr(tab));
+		seq_printf(m, "        entrada[%u] = 0x%016llx  -> PA 0x%llx\n",
+			   idx, e, e & AMDGPU_PTE_MTYPE_NV10_MASK ?
+			   (e & 0x0000FFFFFFFFF000ULL) : (e & 0x0000FFFFFFFFF000ULL));
+		bc250_decodifica(m, e);
+
+		/* neighbours: they reveal the table's local structure */
+		seq_puts(m, "        vizinhas:");
+		for (j = -8; j <= 8; j++) {
+			int v = (int)idx + j;
+
+			if (v < 0 || v > (int)mask)
+				continue;
+			seq_printf(m, " [%d]=0x%llx", v,
+				   bc250_le_entrada(tab, v, m));
+		}
+		seq_puts(m, "\n");
+
+		if (e & AMDGPU_PDE_PTE) {
+			uint64_t tam = 1ULL << (shift + AMDGPU_GPU_PAGE_SHIFT);
+			uint64_t pa  = (e & 0x0000FFFFFFFFF000ULL) + (va & (tam - 1));
+
+			grande = 1;
+			seq_printf(m, "        >>> PAGINA GRANDE de %llu KiB termina aqui\n",
+				   tam >> 10);
+			seq_printf(m, "        >>> PA final = 0x%llx\n", pa);
+
+			/* Does the leaf's PA match what the driver SHOULD have written?
+			 *
+			 * This cannot be computed as "BO base + N * 2 MiB":
+			 * VRAM is allocated in fragments and the BO is not contiguous.
+			 * Measured: CONTROL pages (which the GPU delivers correctly)
+			 * came out shifted by +2, -4, +2 MiB under that naive
+			 * formula -- i.e. the formula is wrong, not the table.
+			 *
+			 * The exact computation is the same one amdgpu_vm_update_range()
+			 * does when WRITING the PTE (amdgpu_vm.c:1210):
+			 *     addr = vram_base + cursor.start
+			 * with the cursor walking the real physical fragments.
+			 */
+			if (mapa && mapa->bo_va && mapa->bo_va->base.bo &&
+			    mapa->bo_va->base.bo->tbo.resource) {
+				struct amdgpu_bo *b = mapa->bo_va->base.bo;
+				struct amdgpu_res_cursor cur2;
+				uint64_t off_bo, esperado;
+
+				off_bo = mapa->offset +
+					 (pfn - mapa->start) * AMDGPU_GPU_PAGE_SIZE;
+				amdgpu_res_first(b->tbo.resource, off_bo,
+						 AMDGPU_GPU_PAGE_SIZE, &cur2);
+				esperado = adev->vm_manager.vram_base_offset +
+					   cur2.start;
+
+				seq_printf(m, "        >>> offset no BO 0x%llx -> fragmento fisico 0x%llx (mem_type=%u)\n",
+					   off_bo, cur2.start, cur2.mem_type);
+				seq_printf(m, "        >>> PA que o driver DEVERIA ter escrito: 0x%llx\n",
+					   esperado);
+				if (pa == esperado) {
+					seq_puts(m, "        >>> VEREDITO: a PTE esta CORRETA.\n"
+						    "        >>> A tabela manda no lugar certo e a GPU\n"
+						    "        >>> entregou outra coisa: defeito ABAIXO da tabela.\n");
+				} else {
+					seq_printf(m, "        >>> VEREDITO: a PTE esta ERRADA por %lld bytes (%lld MiB).\n"
+						      "        >>> O defeito e CONTEUDO DE TABELA DE PAGINA.\n",
+						   (long long)(pa - esperado),
+						   (long long)(pa - esperado) / (1 << 20));
+				}
+			} else {
+				seq_puts(m, "        >>> sem BO/resource para calcular o esperado\n");
+			}
+
+			/* WHOSE is the physical address the table actually points at?
+			 * Scans every mapping of this VM and finds the BO whose
+			 * physical range contains that PA. That answers 'where it went'
+			 * without depending on any marker in the data.
+			 */
+			{
+				struct rb_node *n;
+				int achou = 0;
+
+				seq_puts(m, "        >>> de quem e o PA que a tabela aponta:\n");
+				for (n = rb_first_cached(&vm->va); n; n = rb_next(n)) {
+					struct amdgpu_bo_va_mapping *mp =
+						rb_entry(n, struct amdgpu_bo_va_mapping, rb);
+					struct amdgpu_bo *b2 =
+						mp->bo_va ? mp->bo_va->base.bo : NULL;
+					uint64_t i2, f2;
+
+					if (!b2)
+						continue;
+					i2 = amdgpu_gmc_vram_pa(adev, b2);
+					f2 = i2 + amdgpu_bo_size(b2);
+					if (pa < i2 || pa >= f2)
+						continue;
+					achou = 1;
+					seq_printf(m,
+						"        >>> BO %p [0x%llx,0x%llx) tam=%llu\n"
+						"        >>> mapeado em VA [0x%llx,0x%llx], offset dentro dele 0x%llx\n",
+						b2, i2, f2, (unsigned long long)amdgpu_bo_size(b2),
+						mp->start << AMDGPU_GPU_PAGE_SHIFT,
+						((mp->last + 1) << AMDGPU_GPU_PAGE_SHIFT) - 1,
+						pa - i2);
+				}
+				if (!achou)
+					seq_puts(m, "        >>> NENHUM BO desta VM contem esse PA\n");
+			}
+			break;
+		}
+		if (!(e & AMDGPU_PTE_VALID)) {
+			seq_puts(m, "        >>> ENTRADA INVALIDA -- caminhada para aqui\n");
+			break;
+		}
+		passo++;
+	} while (amdgpu_vm_pt_descendant(adev, &cur));
+
+	/* The 4 KiB leaf lives in the PTB table, and the loop above does not read
+	 * it: the cursor stops ON REACHING that level, so the last decoded entry
+	 * is the PDB0 one. For 2 MiB mappings that is enough (the large page
+	 * ends at PDB0), but for a fine-grained 4 KiB mapping the entry that
+	 * actually decides would be left out.
+	 */
+	if (!grande && cur.level == AMDGPU_VM_PTB && cur.entry && cur.entry->bo) {
+		unsigned int mask  = amdgpu_vm_pt_entries_mask(adev, AMDGPU_VM_PTB);
+		unsigned int shift = amdgpu_vm_pt_level_shift(adev, AMDGPU_VM_PTB);
+		unsigned int idx   = (pfn >> shift) & mask;
+		uint64_t e = bc250_le_entrada(cur.entry->bo, idx, m);
+		int j;
+
+		seq_printf(m, "    [PTB ] folha de 4 KiB  shift=%u mask=0x%x idx=%u\n",
+			   shift, mask, idx);
+		seq_printf(m, "        tabela: bo=%p gpu_addr=0x%llx kptr=%p\n",
+			   cur.entry->bo,
+			   amdgpu_bo_gpu_offset_no_check(cur.entry->bo),
+			   amdgpu_bo_kptr(cur.entry->bo));
+		seq_printf(m, "        entrada[%u] = 0x%016llx  -> PA 0x%llx\n",
+			   idx, e, e & 0x0000FFFFFFFFF000ULL);
+		bc250_decodifica(m, e);
+		seq_puts(m, "        vizinhas:");
+		for (j = -8; j <= 8; j++) {
+			int v = (int)idx + j;
+
+			if (v < 0 || v > (int)mask)
+				continue;
+			seq_printf(m, " [%d]=0x%llx", v,
+				   bc250_le_entrada(cur.entry->bo, v, m));
+		}
+		seq_puts(m, "\n");
+		seq_printf(m, "        >>> PA final = 0x%llx\n",
+			   (e & 0x0000FFFFFFFFF000ULL) + (va & 0xFFF));
+	}
+
+	dma_resv_unlock(vm->root.bo->tbo.base.resv);
+	seq_puts(m, "=== fim ===\n");
+}
