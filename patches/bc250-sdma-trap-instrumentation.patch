 MODULE_FIRMWARE("amdgpu/cyan_skillfish2_sdma.bin");
 MODULE_FIRMWARE("amdgpu/cyan_skillfish2_sdma1.bin");
 
+/* ---------------- BC-250: SDMA trap instrumentation (E2) ----------------
+ *
+ * The question this answers, and that NO previous measurement answered: does
+ * the SDMA0 trap interrupt vector reach the driver?
+ *
+ * Why the previous test was worthless: enabling dyndbg in amdgpu_irq.c only
+ * lights up the dev_dbg for UNKNOWN ids. amdgpu_irq_dispatch prints nothing on
+ * the success path, so "zero lines" ruled out a single hypothesis -- being
+ * dropped for an unregistered id -- and it was read as "the interrupt does not
+ * arrive". Here the log sits in the handler itself, where the IV has already
+ * been dispatched: if the line comes out, it arrived.
+ * A SEPARATE budget per instance, on purpose. With a single counter, sdma1
+ * traffic exhausts the budget and the absence of sdma0 lines becomes
+ * indistinguishable from "it did not arrive" -- exactly the reading error we
+ * are correcting.
+ */
+#define BC250_PCI_DEVICE_ID 0x13FE
+
+static int bc250_sdma_iv_trace[2] = { 64, 16 };
+static int bc250_sdma_iv_trace_n = 2;
+module_param_array(bc250_sdma_iv_trace, int, &bc250_sdma_iv_trace_n, 0644);
+MODULE_PARM_DESC(bc250_sdma_iv_trace,
+	"BC-250: orcamento de log de IV de trap, por instancia SDMA (0 = calado)");
+
+static atomic_t bc250_sdma_iv_visto[2] = { ATOMIC_INIT(0), ATOMIC_INIT(0) };
+
+/* amdgpu_fence_driver_hw_init() only writes TRAP_ENABLE after
+ * amdgpu_device_ip_init() returns in full -- but amdgpu_amdkfd_device_init(),
+ * inside it, has already waited on fences on this ring. In that window the trap
+ * is off by reset value (SDMA0_CNTL = 0x000000c2, bit 0 = 0), and the fences
+ * fall back to the 500 ms timer. That is the most likely explanation for the two
+ * "Fence fallback timer expired on ring sdma0" lines that appear on every boot.
+ *
+ * Enabling it here is safe: amdgpu_irq_dispatch dispatches by client_id/src_id
+ * without consulting src->enabled_types. It applies to BOTH instances, so as not
+ * to create a new asymmetry while investigating one.
+ */
+static int bc250_early_sdma_trap = 1;
+module_param(bc250_early_sdma_trap, int, 0444);
+MODULE_PARM_DESC(bc250_early_sdma_trap,
+	"BC-250: 1=escrever SDMAx_CNTL.TRAP_ENABLE ja no gfx_resume (padrao 1)");
+
+/* READ-ONLY dump of the IH state. Two open questions: are rings 1 and
+ * 2 alive in hardware (Linux never enables NOR disables them), and is
+ * there a filter/drop configured by the console firmware that survived the
+ * Linux boot. Nothing here writes -- writing a wrong drop mask
+ * takes the console down.
+ */
+static int bc250_ih_debug = 1;
+module_param(bc250_ih_debug, int, 0444);
+MODULE_PARM_DESC(bc250_ih_debug,
+	"BC-250: 1=dump somente-leitura do estado do IH ao subir o SDMA (padrao 1)");
+
+static void bc250_dump_ih(struct amdgpu_device *adev)
+{
+	if (!bc250_ih_debug || adev->pdev->device != BC250_PCI_DEVICE_ID)
+		return;
+
+	/* Ring 0: the only one Linux serves. Base and cntl for reference. */
+	dev_info(adev->dev,
+		 "BC-250 ih ring0: base=0x%08x cntl=0x%08x rptr=0x%08x wptr=0x%08x\n",
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_BASE),
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_CNTL),
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_RPTR),
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_WPTR));
+
+	/* Rings 1 and 2: navi10_ih.c zeroes ring_size, which makes Linux IGNORE
+	 * THEM -- it does not disable them. Base != 0 with RB_ENABLE set means the
+	 * console firmware left the ring alive, and an IV routed there disappears
+	 * without a trace. That is the hypothesis that survived.
+	 */
+	dev_info(adev->dev,
+		 "BC-250 ih ring1: base=0x%08x cntl=0x%08x rptr=0x%08x wptr=0x%08x\n",
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_BASE_RING1),
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_CNTL_RING1),
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_RPTR_RING1),
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_WPTR_RING1));
+	dev_info(adev->dev,
+		 "BC-250 ih ring2: base=0x%08x cntl=0x%08x\n",
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_BASE_RING2),
+		 RREG32_SOC15(OSSSYS, 0, mmIH_RB_CNTL_RING2));
+
+	/* Drop and storm control: Linux never writes any of these, so whatever
+	 * is here was left by the PS5 boot ROM.
+	 */
+	dev_info(adev->dev,
+		 "BC-250 ih drop: cntl=0x%08x dest=0x%08x storm=0x%08x\n",
+		 RREG32_SOC15(OSSSYS, 0, mmIH_INT_DROP_CNTL),
+		 RREG32_SOC15(OSSSYS, 0, mmIH_INT_DROP_MATCH_VALUE0),
+		 RREG32_SOC15(OSSSYS, 0, mmIH_STORM_CLIENT_LIST_CNTL));
+}
+
 #define SDMA1_REG_OFFSET 0x600
 #define SDMA0_HYP_DEC_REG_START 0x5880
 #define SDMA0_HYP_DEC_REG_END 0x5893
@@ -835,6 +929,26 @@
 		sdma_v5_0_enable(adev, true);
 	}
 
+	/* BC-250: close the window where the trap is off.
+	 * With a mandatory readback: print the value READ, never the intended one
+	 * -- otherwise "the trap was not the cause" and "the write was ignored"
+	 * become indistinguishable, which is the mistake we already made once today.
+	 */
+	if (bc250_early_sdma_trap && !amdgpu_sriov_vf(adev) &&
+	    adev->pdev->device == BC250_PCI_DEVICE_ID) {
+		u32 reg = sdma_v5_0_get_reg_offset(adev, i, mmSDMA0_CNTL);
+		u32 antes = RREG32(reg);
+		u32 depois;
+
+		WREG32(reg, REG_SET_FIELD(antes, SDMA0_CNTL, TRAP_ENABLE, 1));
+		depois = RREG32(reg);
+		dev_info(adev->dev,
+			 "BC-250 sdma%d: SDMA0_CNTL antes=0x%08x depois=0x%08x TRAP_ENABLE=%lu\n",
+			 i, antes, depois,
+			 (depois & SDMA0_CNTL__TRAP_ENABLE_MASK) >>
+				SDMA0_CNTL__TRAP_ENABLE__SHIFT);
+	}
+
 	return amdgpu_ring_test_helper(ring);
 }
 
